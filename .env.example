# Copy this file to .env and set the values of your host. Git ignores .env.

# The public origin of the site, without a slash at the end.
SITE_URL=https://docs.example

# The external Docker network that the reverse proxy of the host uses. It has no default.
DOCKER_PROXY_NETWORK=proxy-network

# The path of a local clone of tenant-pi, for scripts/capture.py and scripts/check-version.sh.
TENANT_PI_SOURCE=
