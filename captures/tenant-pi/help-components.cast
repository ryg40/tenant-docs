[2.63, "o", "usage: tenant_pi.py components [-h] [--format {json,text}] [--overlay OVERLAY]\r\n"]
[2.68, "o", "                               [--select SELECT] [--manifest MANIFEST]\r\n"]
[2.73, "o", "\r\n"]
[2.78, "o", "options:\r\n"]
[2.83, "o", "  -h, --help            show this help message and exit\r\n"]
[2.88, "o", "  --format {json,text}  json (default): the checklist as data; text: the\r\n"]
[2.93, "o", "                        numbered list for a person\r\n"]
[2.98, "o", "  --overlay OVERLAY     explicit local JSON choices file; the marks are then\r\n"]
[3.03, "o", "                        its selection.enable\r\n"]
[3.08, "o", "  --select SELECT       component IDs or checklist numbers, separated by\r\n"]
[3.13, "o", "                        commas; prints the selection object of an overlay and\r\n"]
[3.18, "o", "                        writes no file\r\n"]
[3.23, "o", "  --manifest MANIFEST   reviewed kit manifest (override remains strictly\r\n"]
[3.28, "o", "                        validated)\r\n"]
