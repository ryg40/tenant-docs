{
  "title": "A refused action",
  "order": 610,
  "command": "python3 scripts/tenant_pi.py generate \\\n  --overlay \"$HOME/.config/tenant-pi/overlay.json\" \\\n  --target \"$HOME/.pi/profiles/main\"; echo \"exit code: $?\"",
