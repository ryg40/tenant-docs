    "test -e \"$HOME/.pi/profiles/main\" || python3 scripts/tenant_pi.py generate --overlay \"$HOME/.config/tenant-pi/overlay.json\" --target \"$HOME/.pi/profiles/main\" > /dev/null"
  ],
