[2.22, "o", "\r\n"]
[2.57, "o", "usage: tenant_pi.py generate [-h] --overlay OVERLAY [--manifest MANIFEST]\r\n"]
[2.62, "o", "                             [--registry REGISTRY]\r\n"]
[2.67, "o", "                             [--require-role REQUIRE_ROLE]\r\n"]
[2.72, "o", "                             [--local-dir LOCAL_DIR] --target TARGET\r\n"]
