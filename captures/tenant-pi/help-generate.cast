[2.82, "o", "                             [--runtime-report RUNTIME_REPORT]\r\n"]
[2.87, "o", "                             [--herdr-report HERDR_REPORT]\r\n"]
[2.92, "o", "\r\n"]
[2.97, "o", "options:\r\n"]
[3.02, "o", "  -h, --help            show this help message and exit\r\n"]
[3.07, "o", "  --overlay OVERLAY     explicit local JSON choices file\r\n"]
[3.12, "o", "  --manifest MANIFEST   reviewed kit manifest (override remains strictly\r\n"]
[3.17, "o", "                        validated)\r\n"]
[3.22, "o", "  --registry REGISTRY   explicit offline capability JSON map; not Pi\r\n"]
[3.27, "o", "                        models.json\r\n"]
[3.32, "o", "  --require-role REQUIRE_ROLE\r\n"]
[3.37, "o", "                        require an explicit reviewed role; repeat for more\r\n"]
[3.42, "o", "                        roles\r\n"]
[3.47, "o", "  --local-dir LOCAL_DIR\r\n"]
[3.52, "o", "                        absolute directory that holds the fixed overlay.inputs\r\n"]
[3.57, "o", "                        slots (default: the kit's .local)\r\n"]
[3.62, "o", "  --target TARGET       explicit absent agent directory; must match overlay\r\n"]
[3.67, "o", "  --launcher LAUNCHER   absolute path of an absent launcher file; written\r\n"]
[3.72, "o", "                        after a complete generation\r\n"]
[3.77, "o", "  --runtime-report RUNTIME_REPORT\r\n"]
[3.82, "o", "                        explicit JSON output of a previous check-runtime run;\r\n"]
[3.87, "o", "                        the readiness gaps then show the measured runtime\r\n"]
[3.92, "o", "                        versions\r\n"]
[3.97, "o", "  --herdr-report HERDR_REPORT\r\n"]
[4.02, "o", "                        explicit JSON output of a previous check-herdr run;\r\n"]
[4.07, "o", "                        the readiness gaps then show the measured herdr\r\n"]
[4.12, "o", "                        command\r\n"]
