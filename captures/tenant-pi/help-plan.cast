[2.7, "o", "\r\n"]
[2.75, "o", "options:\r\n"]
[2.8, "o", "  -h, --help            show this help message and exit\r\n"]
[2.85, "o", "  --overlay OVERLAY     explicit local JSON choices file\r\n"]
[2.9, "o", "  --manifest MANIFEST   reviewed kit manifest (override remains strictly\r\n"]
[2.95, "o", "                        validated)\r\n"]
[3.0, "o", "  --registry REGISTRY   explicit offline capability JSON map; not Pi\r\n"]
[3.05, "o", "                        models.json\r\n"]
[3.1, "o", "  --require-role REQUIRE_ROLE\r\n"]
[3.15, "o", "                        require an explicit reviewed role; repeat for more\r\n"]
[3.2, "o", "                        roles\r\n"]
[3.25, "o", "  --local-dir LOCAL_DIR\r\n"]
[3.3, "o", "                        absolute directory that holds the fixed overlay.inputs\r\n"]
[3.35, "o", "                        slots (default: the kit's .local)\r\n"]
[3.4, "o", "  --launcher LAUNCHER   absolute path of an absent launcher file; display only\r\n"]
[3.45, "o", "  --runtime-report RUNTIME_REPORT\r\n"]
[3.5, "o", "                        explicit JSON output of a previous check-runtime run;\r\n"]
[3.55, "o", "                        the readiness gaps then show the measured runtime\r\n"]
[3.6, "o", "                        versions\r\n"]
[3.65, "o", "  --herdr-report HERDR_REPORT\r\n"]
