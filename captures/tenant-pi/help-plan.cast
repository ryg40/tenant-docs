[2.45, "o", "usage: tenant_pi.py plan [-h] --overlay OVERLAY [--manifest MANIFEST]\r\n"]
[2.5, "o", "                         [--registry REGISTRY] [--require-role REQUIRE_ROLE]\r\n"]
[2.55, "o", "                         [--local-dir LOCAL_DIR] [--launcher LAUNCHER]\r\n"]
