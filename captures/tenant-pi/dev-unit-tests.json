{
  "title": "Gate 1: the offline unit tests",
  "order": 810,
  "ref": "main",
  "command": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -q",
  "setup": [
    "git clone -q /srv/tenant-pi.git \"$HOME/tenant-pi\"",
    "cd \"$HOME/tenant-pi\""
  ],
  "replace": [
    {
      "what": "the run time of the tests",
      "match": "Ran \\d+ tests? in ([0-9.]+)s",
      "with": "<seconds>"
    }
  ],
  "mode": "scripted"
}
