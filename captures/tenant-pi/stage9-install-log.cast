[2.82, "o", "\r\n"]
[2.87, "o", "## 2026-10-05: first profile, core only\r\n"]
[2.92, "o", "\r\n"]
[2.97, "o", "- Kit commit: f47fd90d2015467a92bcec82166323aae7cfe236\r\n"]
