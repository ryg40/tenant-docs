[2.3, "o", "usage: tenant_pi.py [-h]\r\n"]
[2.35, "o", "                    {compare,carry,inventory,list,check-runtime,init-private,validate,plan,generate}\r\n"]
[2.4, "o", "                    ...\r\n"]
[2.45, "o", "\r\n"]
[2.5, "o", "Offline, new-profile-only tenant-pi CLI (Python 3.11+).\r\n"]
[2.55, "o", "\r\n"]
[2.6, "o", "positional arguments:\r\n"]
[2.65, "o", "  {compare,carry,inventory,list,check-runtime,init-private,validate,plan,generate}\r\n"]
[2.7, "o", "    compare             redacted field comparison of two explicit profile\r\n"]
[2.75, "o", "                        directories\r\n"]
[2.8, "o", "    carry               print overlay patches that adopt owner-owned changes\r\n"]
[2.85, "o", "                        of a compare report\r\n"]
[2.9, "o", "    inventory           names-only resource list of one explicit profile\r\n"]
[2.95, "o", "                        directory\r\n"]
[3.0, "o", "    list                read-only state list of the candidate directories\r\n"]
[3.05, "o", "                        under one explicit parent\r\n"]
[3.1, "o", "    check-runtime       compare the installed Pi, Node and Python with\r\n"]
[3.15, "o", "                        manifest.runtime\r\n"]
[3.2, "o", "    init-private        create a new private directory for the overlay and its\r\n"]
[3.25, "o", "                        records\r\n"]
[3.3, "o", "    validate            validate a private local overlay\r\n"]
[3.35, "o", "    plan                plan a private local overlay\r\n"]
[3.4, "o", "    generate            generate a private local overlay\r\n"]
[3.45, "o", "\r\n"]
[3.5, "o", "options:\r\n"]
[3.55, "o", "  -h, --help            show this help message and exit\r\n"]
