[2.34, "o", "\r\n"]
[2.69, "o", "usage: tenant_pi.py compose-plan [-h] [--account ACCOUNT] --uid UID --gid GID\r\n"]
[2.74, "o", "                                 --public-key PUBLIC_KEY [--ssh-port SSH_PORT]\r\n"]
[2.79, "o", "                                 [--projects-dir PROJECTS_DIR] --gateway-url\r\n"]
[2.84, "o", "                                 GATEWAY_URL [--key-var KEY_VAR]\r\n"]
[2.89, "o", "                                 [--enable ENABLE] [--provider PROVIDER]\r\n"]
[2.94, "o", "                                 --model MODEL [--thinking THINKING]\r\n"]
[2.99, "o", "                                 --private-dir PRIVATE_DIR [--clone CLONE]\r\n"]
[3.04, "o", "                                 [--write] [--manifest MANIFEST]\r\n"]
[3.09, "o", "\r\n"]
[3.14, "o", "options:\r\n"]
[3.19, "o", "  -h, --help            show this help message and exit\r\n"]
[3.24, "o", "  --account ACCOUNT     account name of the seat (default: pi)\r\n"]
[3.29, "o", "  --uid UID             UID of the account: the UID of the user (id -u)\r\n"]
[3.34, "o", "  --gid GID             GID of the account: the GID of the user (id -g)\r\n"]
[3.39, "o", "  --public-key PUBLIC_KEY\r\n"]
[3.44, "o", "                        absolute path of the SSH public key file of the user\r\n"]
[3.49, "o", "  --ssh-port SSH_PORT   port on this machine that receives the SSH connections\r\n"]
[3.54, "o", "                        (default: 2222)\r\n"]
[3.59, "o", "  --projects-dir PROJECTS_DIR\r\n"]
[3.64, "o", "                        absolute path of the optional projects directory\r\n"]
[3.69, "o", "  --gateway-url GATEWAY_URL\r\n"]
[3.74, "o", "                        credential-free HTTPS URL of the gateway; it ends in\r\n"]
[3.79, "o", "                        /v1\r\n"]
[3.84, "o", "  --key-var KEY_VAR     name of the variable that holds the gateway key\r\n"]
[3.89, "o", "                        (default: TENANTEXT_LITELLM_API_KEY)\r\n"]
[3.94, "o", "  --enable ENABLE       component ID to enable; repeat for more components\r\n"]
[3.99, "o", "  --provider PROVIDER   provider of the interactive role (default: litellm-\r\n"]
[4.04, "o", "                        codex)\r\n"]
[4.09, "o", "  --model MODEL         model of the interactive role: codex-auto/luna, codex-\r\n"]
[4.14, "o", "                        auto/sol or codex-auto/astra\r\n"]
[4.19, "o", "  --thinking THINKING   thinking level of the interactive role (default: high)\r\n"]
[4.24, "o", "  --private-dir PRIVATE_DIR\r\n"]
[4.29, "o", "                        absolute path of the existing private directory,\r\n"]
[4.34, "o", "                        outside the clone\r\n"]
[4.39, "o", "  --clone CLONE         absolute path of the kit clone (default: this clone)\r\n"]
[4.44, "o", "  --write               write overlay.json, seat.env, compose.env,\r\n"]
[4.49, "o", "                        authorized_keys and registry.json into the private\r\n"]
[4.54, "o", "                        directory; each must be absent\r\n"]
[4.59, "o", "  --manifest MANIFEST   reviewed kit manifest (override remains strictly\r\n"]
[4.64, "o", "                        validated)\r\n"]
[4.94, "o", "$ "]
