---
// An annotated screenshot. Each callout has a number, a position in percent of the image, and a text.
// A mark on the image links to its text in the list, and the number in the list links back to the mark.
// The marks scale with the image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Callout {
	n: number;
	x: number;
	y: number;
	text: string;
}

interface Props {
	src: ImageMetadata;
	alt: string;
	callouts?: Callout[];
}

const { src, alt, callouts = [] } = Astro.props;

// An id prefix for this image with this set of callouts. Two shots on one page get different links.
let hash = 5381;
for (const char of src.src + JSON.stringify(callouts)) hash = ((hash << 5) + hash + char.charCodeAt(0)) >>> 0;
const key = `shot-${hash.toString(36)}`;
---

<figure class="shot not-content">
	<div class="shot-frame" style={`max-width: ${src.width}px`}>
		<Image src={src} alt={alt} />
		{
			callouts.map((callout) => (
				<a
					class="shot-mark"
					id={`${key}-mark-${callout.n}`}
					href={`#${key}-note-${callout.n}`}
					style={`left: ${callout.x}%; top: ${callout.y}%`}
					aria-label={`Callout ${callout.n}: ${callout.text}`}
				>
					{callout.n}
				</a>
			))
		}
	</div>
	{
		callouts.length > 0 && (
			<ol class="shot-notes">
				{callouts.map((callout) => (
					<li id={`${key}-note-${callout.n}`}>
						<a class="shot-num" href={`#${key}-mark-${callout.n}`} aria-label={`Callout ${callout.n} on the image`}>
							{callout.n}
						</a>
						<span>{callout.text}</span>
					</li>
				))}
			</ol>
		)
	}
</figure>

<style>
	.shot {
		margin: 1.5rem 0;
	}
	/* The frame is the size container. One unit `cqi` is one percent of the image width. */
	.shot-frame {
		position: relative;
		container-type: inline-size;
		--mark: clamp(1.5rem, 4.4cqi, 2.25rem);
	}
	.shot-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--sn-rule);
		border-radius: 10px;
	}
	.shot-mark,
	.shot-num {
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--sn-sea);
		color: var(--sn-dark);
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
	}
	.shot-mark {
		position: absolute;
		width: var(--mark);
		height: var(--mark);
		transform: translate(-50%, -50%);
		font-size: calc(var(--mark) * 0.52);
		box-shadow:
			0 0 0 2px var(--sn-ground),
			0 2px 8px var(--sn-well);
		scroll-margin-top: 6rem;
	}
	.shot-mark:hover,
	.shot-num:hover {
		background: var(--sn-sea-ink);
	}
	.shot-mark:target {
		box-shadow:
			0 0 0 2px var(--sn-ground),
			0 0 0 5px var(--sn-warn);
	}
	.shot-notes {
		display: grid;
		gap: 0.5rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}
	.shot-notes li {
		display: grid;
		grid-template-columns: 1.5rem 1fr;
		gap: 0.7rem;
		align-items: start;
		padding: 0.3rem 0.5rem;
		border-radius: 8px;
		color: var(--sn-muted);
	}
	.shot-notes li:target {
		background: var(--sn-panel);
		color: var(--sn-ink);
		box-shadow: inset 0 0 0 1px var(--sn-warn);
	}
	.shot-num {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.15rem;
		font-size: 0.8rem;
	}
</style>
